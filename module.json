  "readme": "https://github.com/sargas79/sargas-compendium-manager/blob/main/README.md",
  "changelog": "https://github.com/sargas79/sargas-compendium-manager/blob/main/CHANGELOG.md",
  "license": "https://github.com/sargas79/sargas-compendium-manager/blob/main/LICENSE",
